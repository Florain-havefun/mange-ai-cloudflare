{
  "name": "mange-ai-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/check-deploy-config.mjs && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:remote": "node scripts/check-deploy-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test:session": "node tests/session-info.mjs",
    "test:orders": "node tests/order-api.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": { "miniflare": { "sharp": "0.35.4" } }
}
